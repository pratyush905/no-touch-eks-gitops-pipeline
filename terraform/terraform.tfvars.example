aws_region   = "us-east-1"
project_name = "eks-gitops-platform"
environment  = "dev"

vpc_cidr = "10.20.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b",
  "us-east-1c",
]

kubernetes_version = "1.35"

node_instance_types = [
  "t3.medium",
]

node_min_size     = 1
node_desired_size = 2
node_max_size     = 4

single_nat_gateway = true

tags = {
  CostCenter = "portfolio"
  Purpose    = "eks-gitops-demo"
}
